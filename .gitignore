# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# analysis-worker dry-run build output
analysis-worker/.dry/
analysis-worker/analysis-worker/

# Claude Code local state (settings, worktrees) — never commit.
# Skills and agents are tracked: .claude/* ignores direct children, the !lines re-include them.
.claude/*
!.claude/skills/
!.claude/agents/

# Local QA artefact output from test runs. Intentional committed fixtures
# (e.g. qa-artifacts/GF-01-*) remain tracked; use `git add -f` to add new ones.
qa-artifacts/

# Local env overrides (real secrets never belong in tracked files).
# NOTE: .env itself is deliberately tracked: it holds ONLY public Supabase
# client values and is maintained by the Lovable sync (audited 2026-06-05).
.env.local
.env.*.local

# Obsidian workspace state for the knowledge vault (machine-local, not shared)
knowledge/.obsidian/
