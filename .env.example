# TapeCoach environment variables — names and placeholders only.
#
# NOTE ON .env: the tracked .env in this repo holds ONLY public client values
# (Supabase URL / publishable key / project id — full git history audited
# 2026-06-05, no secret ever committed) and is maintained by the Lovable sync.
# Real secrets live in the Lovable app env, Cloudflare Worker secrets and
# Supabase Vault — never in tracked files. Local-only overrides belong in
# .env.local / .env.*.local (gitignored).
#
# See env-vars.md for the operator-facing documentation of these names.

# ── Supabase — public client (safe to expose; shipped in the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# ── Supabase — owned project, server-only (Lovable reserves the SUPABASE_ prefix)
TAPECOACH_SUPABASE_URL=https://your-project.supabase.co
TAPECOACH_SUPABASE_SERVICE_ROLE_KEY=service-role-key-never-commit
# Legacy local/dev fallbacks only:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mux (media)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ── OpenRouter / S10 analysis models
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_SITE_URL=https://tapecoach.co.uk
OPENROUTER_APP_TITLE=TapeCoach
S10_MODEL_STEP1=
S10_MODEL_STEP2=
S10_MODEL_RECOVERY=
EVIDENCE_PASS_MODEL=
REPORT_POLISH_MODEL=
ANALYSIS_MODEL_PRIMARY=
ANALYSIS_MODEL_FALLBACK=
# Lovable AI gateway fallback provider:
LOVABLE_API_KEY=

# ── Analysis runtime tuning (optional overrides)
ANALYSIS_GEMINI_TIMEOUT_MS=
ANALYSIS_MAX_RETRIES=
BRIEF_EXTRACTION_TIMEOUT_MS=
EVIDENCE_PASS_MAX_TOKENS=
REPORT_POLISH_MAX_TOKENS=
REPORT_OUTPUT_MAX_TOKENS=
EVIDENCE_PASS_PROVIDER_CONTRACT=

# ── Analysis dispatch (app -> dedicated Cloudflare analysis Worker; ADR-0003)
ANALYSIS_DISPATCH_URL=
ANALYSIS_DISPATCH_SECRET=
# Deprecated — scheduled for removal (see env-vars.md / ADR-0003):
ANALYSIS_RUN_SECRET=

# ── Stripe (consumer credit purchases)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Brevo / email
BREVO_API_KEY=
TAPECOACH_EMAIL_FROM=
TAPECOACH_EMAIL_SENDER_DOMAIN=
TAPECOACH_UNSUBSCRIBE_BASE_URL=
TAPECOACH_ADMIN_EMAIL=

# ── Reconciler / cutover / session secrets
# Vault secret name and app env var must BOTH be RECONCILER_SECRET, same value.
RECONCILER_SECRET=
CUTOVER_HEALTH_SECRET=
ANON_SESSION_SECRET=

# ── Site
PUBLIC_SITE_URL=https://tapecoach.co.uk
SITE_URL=

# ── Feature flags (product toggles should live in DB/admin config; these are
#    deployment-level gates only)
TWO_STEP_ANALYSIS_ENABLED=true
INTERNAL_COMPARISON_TRIGGER_ENABLED=true
PUBLIC_COMPARISON_OUTPUT_ENABLED=
DOWNLOAD_ENABLED=
EXPORT_ENABLED=
SHARE_ENABLED=

# ── QA artefacts
QA_ARTIFACT_SINK=storage
QA_ARTIFACT_STORAGE_BUCKET=qa-artifacts
QA_ARTIFACT_STORAGE_TIMEOUT_MS=
QA_ARTIFACT_LOG_FALLBACK=true
V3_QA_ARTIFACTS_ENABLED=true
INTERNAL_QA_EMIT=true
