{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tapecoach.local/orchestrator/linear/task-state.schema.json",
  "title": "TapeCoach MVP Linear Task State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_name",
    "branch",
    "source_hierarchy_checked",
    "chatgpt_prompt_issued_to_codex",
    "operator_manual_codex_run_required",
    "codex_task_status",
    "chatgpt_decision_after_summary",
    "pr_creation_status",
    "review_cycles",
    "github_checks_status",
    "deferred_items",
    "operator_verification_required_items",
    "merge_recommendation",
    "merge_status",
    "next_task_recommendation",
    "blocked_states"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "task_name": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "pr_link": { "type": "string" },
    "source_hierarchy_checked": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "chatgpt_prompt_issued_to_codex": { "type": "string", "minLength": 1 },
    "operator_manual_codex_run_required": { "const": true },
    "codex_task_status": {
      "enum": ["not_started", "running", "complete", "failed", "stopped"]
    },
    "codex_summary": { "type": "string" },
    "chatgpt_decision_after_summary": {
      "enum": ["pending", "fix", "create_pr", "stop"]
    },
    "pr_creation_status": {
      "enum": ["not_started", "operator_required", "created", "blocked"]
    },
    "pr_review_has_begun": { "type": "boolean" },
    "review_cycles": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_cycle" }
    },
    "github_checks_status": {
      "enum": ["not_started", "pending", "passed", "failed", "blocked"]
    },
    "deferred_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operator_verification_required_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "merge_recommendation": { "type": "boolean" },
    "merge_status": {
      "enum": ["not_started", "operator_required", "manually_squash_merged", "blocked"]
    },
    "next_task_recommendation": { "type": "string" },
    "blocked_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level_2",
        "production_safe",
        "public_scoring",
        "public_technique_authority",
        "comparison_public_winner",
        "customer_facing_release"
      ],
      "properties": {
        "level_2": { "const": "not_accepted" },
        "production_safe": { "const": "blocked" },
        "public_scoring": { "const": "blocked" },
        "public_technique_authority": { "const": "blocked" },
        "comparison_public_winner": { "const": "blocked" },
        "customer_facing_release": { "const": "blocked" }
      }
    }
  },
  "$defs": {
    "review_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_number",
        "review_requested_at",
        "reviewer_source",
        "review_result",
        "bugs_found",
        "p0_findings",
        "p1_findings",
        "p2_findings",
        "chatgpt_triage_decision",
        "codex_fix_prompt",
        "codex_fix_summary",
        "github_checks_after_fix",
        "continue_review_required"
      ],
      "properties": {
        "round_number": { "type": "integer", "minimum": 1 },
        "review_requested_at": { "type": "string" },
        "reviewer_source": { "type": "string", "minLength": 1 },
        "review_result": {
          "enum": ["pending", "no_findings", "findings", "check_failure", "blocked"]
        },
        "bugs_found": { "type": "array", "items": { "type": "string" } },
        "p0_findings": { "type": "array", "items": { "type": "string" } },
        "p1_findings": { "type": "array", "items": { "type": "string" } },
        "p2_findings": { "type": "array", "items": { "type": "string" } },
        "chatgpt_triage_decision": {
          "enum": ["pending", "fix", "defer", "stop", "merge_candidate"]
        },
        "codex_fix_prompt": { "type": "string" },
        "codex_fix_summary": { "type": "string" },
        "github_checks_after_fix": {
          "enum": ["not_started", "pending", "passed", "failed", "blocked"]
        },
        "continue_review_required": { "type": "boolean" }
      }
    }
  }
}
