{
  "$schema": "node_modules/wrangler/config-schema.json",
  // NEUTRALISED / TRANSITIONAL — do not deploy this config to the production
  // analysis service. The durable analysis runtime is the dedicated worker in
  // `analysis-worker/wrangler.jsonc` (service name `tapecoach-analysis-worker`,
  // the ANALYSIS_DISPATCH_URL target). See docs/architecture ADR-0003.
  //
  // This root config was the old app+queue hybrid. Under the current topology the
  // TanStack/Lovable app is hosted by Lovable, not deployed to Cloudflare from
  // here. To remove the footgun where two configs could deploy to the same
  // Cloudflare service and overwrite each other, this config:
  //   - uses a distinct, clearly-unused service name (NOT tapecoach-analysis-worker);
  //   - declares NO queue producer/consumer bindings (the dedicated analysis
  //     Worker owns the ANALYSIS_QUEUE producer and the sole tapecoach-analysis-jobs
  //     consumer).
  // Cloudflare Workers Builds for `tapecoach-analysis-worker` must use
  // `npm run deploy:analysis-worker` (analysis-worker/wrangler.jsonc), never this file.
  "name": "tapecoach-app-worker-unused",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker-entry.ts",
  "vars": {
    "APP_ENV": "production",
    "ANALYSIS_EXECUTION_MODE": "current_worker",
    "QA_ARTIFACT_STORAGE_BUCKET": "qa-artifacts",
    "QA_ARTIFACT_SINK": "storage",
  },
}
