{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker service name. MUST stay in sync with the deployed analysis worker
  // and the producer's ANALYSIS_DISPATCH_URL host
  // (https://tapecoach-analysis-worker.o-halawi90.workers.dev/api/internal/run-analysis).
  // Cloudflare Workers Builds deploys to the service named here, so a mismatch
  // would publish to a different worker and leave the dispatch target stale
  // (404 / analysis_external_dispatch_failed). Do not rename without updating
  // ANALYSIS_DISPATCH_URL to match.
  "name": "tapecoach-analysis-worker",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker-entry.ts",
  // Queue-consumer CPU budget. CPU time is *active processing* only — it does
  // NOT include the (long) I/O waits on the Gemini Step-1/Step-2 fetches. But
  // the two-step pipeline builds and re-validates large (~27KB) report objects
  // multiple times per take (main polish + module-repair retry + readiness and
  // output-enforcement passes) for self-tapes up to the 10-minute product
  // maximum. The default 30s CPU ceiling is a real exhaustion risk under that
  // load (surfaces as `exceededCpu` / Error 1102 → orphaned take before
  // persist). Raise to the 5-minute queue-consumer maximum. Wall-clock is
  // already 15min for queue consumers, so wall-clock is not the binding limit.
  "limits": {
    "cpu_ms": 300000
  },
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "tapecoach-analysis-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "tapecoach-analysis-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5
      }
    ]
  }
}
