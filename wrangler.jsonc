{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker service name. MUST stay in sync with the deployed analysis worker
  // and the producer's ANALYSIS_DISPATCH_URL host
  // (https://tapecoach-analysis-worker.o-halawi90.workers.dev/api/internal/run-analysis).
  // Cloudflare Workers Builds deploys to the service named here, so a mismatch
  // would publish to a different worker and leave the dispatch target stale
  // (404 / analysis_external_dispatch_failed). Do not rename without updating
  // ANALYSIS_DISPATCH_URL to match.
  "name": "tapecoach-analysis-worker",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker-entry.ts",
  // NOTE: a custom `limits.cpu_ms` is intentionally NOT set here. This account
  // is on the Workers **Free** plan, which rejects custom CPU limits at deploy
  // (Cloudflare API error 100328: "CPU limits are not supported for the Free
  // plan"). The two-step report build is CPU-heavy on 10-minute-max self-tapes,
  // so when the account moves to **Workers Paid**, add:
  //   "limits": { "cpu_ms": 300000 }   // 5-min queue-consumer maximum
  // to lift the CPU ceiling (otherwise the Free default CPU limit can kill the
  // report assembly — `exceededCpu`). Wall-clock is already 15min for queue
  // consumers, so wall-clock is not the binding limit.
  // The consumer for tapecoach-analysis-jobs lives ONLY on the dedicated analysis
  // Worker (analysis-worker/wrangler.jsonc) — see docs/architecture ADR-0003's
  // one-consumer rule. Cloudflare Queues rejects multiple consumers for one queue,
  // so this app Worker must NOT declare a consumer. The producer binding is kept
  // for the app's legacy in-Worker dispatch fallback.
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "tapecoach-analysis-jobs",
      },
    ],
  },
  "vars": {
    "APP_ENV": "production",
    "ANALYSIS_EXECUTION_MODE": "current_worker",
    "QA_ARTIFACT_STORAGE_BUCKET": "qa-artifacts",
    "QA_ARTIFACT_SINK": "storage",
  },
}
